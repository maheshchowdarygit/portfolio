# Resend API Key for sending emails from the contact form
# Get one at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Contact form recipient email (default fallback: mahesh@example.com)
CONTACT_EMAIL=mahesh@example.com

# Site URL for metadata & sitemaps
NEXT_PUBLIC_SITE_URL=https://mahesh-portfolio.vercel.app
